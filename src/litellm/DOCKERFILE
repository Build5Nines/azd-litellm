# https://docs.litellm.ai/docs/proxy/deploy

# Use LiteLLM's database-enabled image to avoid building Prisma artifacts in our own Docker build.
FROM ghcr.io/berriai/litellm-database:main-stable

WORKDIR /app

COPY config.yaml .

EXPOSE 4000/tcp

ENTRYPOINT ["litellm"]
CMD ["--port", "4000", "--config", "/app/config.yaml"]